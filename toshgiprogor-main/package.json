{
  "name": "toshgiprogor",
  "version": "1.0.0",
  "description": "TOSHGIPROGOR ASJ — Toshkent shahar loyihalash instituti rasmiy sayti",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "sass assets/scss/style.scss assets/css/style.css --no-source-map --style=compressed --quiet",
    "css:watch": "sass --watch assets/scss/style.scss assets/css/style.css --no-source-map --quiet",
    "dev": "npm run css && vite",
    "build": "npm run css && vite build && node scripts/pre-render.js",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.js",
    "seo": "node scripts/pre-render.js",
    "lint": "eslint assets/js",
    "format": "prettier --write \"**/*.{js,scss,html}\" --ignore-path .prettierignore"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.19",
    "cssnano": "^7.0.4",
    "eslint": "^9.5.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.2",
    "sass": "^1.77.6",
    "sharp": "^0.33.4",
    "vite": "^5.3.1",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
