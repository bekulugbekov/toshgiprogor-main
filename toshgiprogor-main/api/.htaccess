# Apache: PHP fayl handleri
<Files "telegram.php">
    SetHandler application/x-httpd-php
</Files>
<Files "contact.php">
    SetHandler application/x-httpd-php
</Files>
<Files "cooperation.php">
    SetHandler application/x-httpd-php
</Files>

# Logs katalogiga to'g'ridan-to'g'ri kirish taqiqlanadi
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^logs/ - [F,L]
</IfModule>

# OPTIONS preflightni tezkor qaytarish
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
